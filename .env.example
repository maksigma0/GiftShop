# Папка для базы SQLite и загруженных фото (должна быть доступна на запись)
NUXT_DATA_DIR=./data

# Пароль входа в админку /admin
NUXT_ADMIN_PASSWORD=

# Секрет для шифрования cookie сессии админки, минимум 32 символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Порт, на котором слушает сервер (на хостинге обычно задаёт сам хостинг)
PORT=3000
